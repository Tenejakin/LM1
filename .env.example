EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Bunny Storage credentials belong in Supabase Edge Function secrets, not in
# this Expo .env file. Never prefix these values with EXPO_PUBLIC_.
# Set BUNNY_STORAGE_ENDPOINT and the WRITE-capable Password shown in Bunny's
# Storage Zone credentials. Do not use the Read-only password.
# Set these with `supabase secrets set` when deploying the upload function.
# BUNNY_STORAGE_ENDPOINT=https://storage.bunnycdn.com/lm1-live
# BUNNY_STORAGE_PASSWORD=your-storage-zone-write-password
# BUNNY_STORAGE_READ_ONLY_PASSWORD=your-optional-read-only-password

# Optional: configure only if LM1 should also read/display uploaded images via
# a Bunny Pull Zone or custom CDN hostname.
# BUNNY_CDN_BASE_URL=https://your-pull-zone-or-custom-domain
