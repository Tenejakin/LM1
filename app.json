{
  "expo": {
    "name": "LM1",
    "slug": "pinpoint-launch-monitor",
    "version": "3.38.0",
    "orientation": "portrait",
    "scheme": "pinpoint",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "70",
      "bundleIdentifier": "com.pinpoint.launchmonitor",
      "infoPlist": {
        "CFBundleDisplayName": "LM1",
        "NSLocalNetworkUsageDescription": "LM1 uses the local network for golf simulator connections.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 70,
      "package": "com.pinpoint.launchmonitor",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Allow LM1 to connect to your Raspberry Pi launch monitor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d6ac2e51-21e7-41d0-b91f-d271ba6c0a31"
      }
    }
  }
}
