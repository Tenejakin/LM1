[Unit]
Description=LM1 PRO Launch Monitor BLE Peripheral
After=bluetooth.service dbus.service NetworkManager.service
Requires=bluetooth.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/default/pinpoint
WorkingDirectory=/opt/pinpoint
ExecStart=/opt/pinpoint/.venv/bin/python /opt/pinpoint/pinpoint_ble.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pinpoint

[Install]
WantedBy=multi-user.target
