{
  "expo": {
    "name": "LM1",
    "slug": "pinpoint-launch-monitor",
    "version": "3.44.1",
    "orientation": "portrait",
    "scheme": "pinpoint",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "77",
      "bundleIdentifier": "com.pinpoint.launchmonitor",
      "infoPlist": {
        "CFBundleDisplayName": "LM1",
        "NSLocalNetworkUsageDescription": "LM1 uses the local network for golf simulator connections.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/icon.png"
    },
    "android": {
      "versionCode": 74,
      "package": "com.pinpoint.launchmonitor",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E212A"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "bluetoothAlwaysPermission": "Allow LM1 to connect to your Raspberry Pi launch monitor."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d6ac2e51-21e7-41d0-b91f-d271ba6c0a31"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E212A"
    }
  }
}
