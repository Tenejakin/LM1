{
  "name": "pinpoint-launch-monitor",
  "version": "3.11.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android --device",
    "ios": "expo run:ios --device",
    "web": "expo start --web",
    "build:android:dev": "npx eas-cli build --profile development --platform android",
    "build:ios:dev": "npx eas-cli build --profile development --platform ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "ogs:bridge": "node bridge/opengolfsim-bridge.cjs",
    "test:ogs": "node scripts/test-opengolfsim-bridge.cjs",
    "test:capture": "node scripts/test-capture-client.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-build-properties": "~1.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "js-base64": "^3.7.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "ws": "^8.21.3"
  }
}
